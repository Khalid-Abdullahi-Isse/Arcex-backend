DATABASE_URL="postgresql://arcex:replace-with-db-password@postgres:5432/acrex?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

S3_BUCKET="acrex-local"
S3_REGION="us-east-1"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="replace-with-minio-or-s3-access-key"
S3_SECRET_KEY="replace-with-minio-or-s3-secret-key"
SMS_API_KEY="local"

THROTTLE_TTL=60
THROTTLE_LIMIT=100
